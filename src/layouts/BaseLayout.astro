---
const { title = 'The Unlearned Investor', description = 'Independent investing lessons, thoughtful research and the latest from The Unlearned Investor.', canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const logo = 'https://substack-post-media.s3.amazonaws.com/public/images/95f8cb92-384e-4497-a4f4-53a238823a5d_1400x1400.png';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content={description}/><link rel="canonical" href={url}/>
<link rel="icon" type="image/png" href={logo}/><link rel="apple-touch-icon" href={logo}/>
<title>{title === 'The Unlearned Investor' ? title : title + ' | The Unlearned Investor'}</title>
<style is:global>
:root{font-family:Georgia,"Times New Roman",serif;color:#242a2c;background:#fcfbf8}*{box-sizing:border-box}body{margin:0}a{color:#145e66;text-decoration:none}a:hover{text-decoration:underline}
header{background:#fff;border-bottom:1px solid #e6e3dc}.masthead{padding:30px 20px 22px;text-align:center}.masthead img{display:block;margin:0 auto 13px;width:88px;height:88px;object-fit:contain;border-radius:50%}.brand{font-family:Georgia,serif;font-weight:700;font-size:clamp(1.65rem,4vw,2.6rem);letter-spacing:-.025em;color:#202b2c}
.menu{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:0 32px;border-top:1px solid #f0eee9;padding:16px 20px;font-family:Arial,sans-serif;font-size:.91rem;font-weight:600}.menu a{color:#384748;padding:7px 0}.menu a:hover,.menu a[aria-current="page"]{color:#116c70;text-decoration:underline;text-underline-offset:7px}
main{max-width:940px;margin:auto;padding:48px 24px 90px;min-height:50vh}.article{max-width:760px;margin:auto}.eyebrow{font:700 .78rem Arial,sans-serif;text-transform:uppercase;letter-spacing:.14em;color:#27787b}h1{font-size:clamp(2.1rem,5vw,3.5rem);line-height:1.12;letter-spacing:-.03em;margin:15px 0 24px}h2{font-size:1.75rem}p{line-height:1.8;color:#465356}.lead{font-size:1.2rem;max-width:720px}.muted{font: .9rem Arial,sans-serif;color:#748084}.post-list{display:flex;flex-direction:column;gap:0;margin-top:30px}.post-preview{display:block;padding:25px 0;border-bottom:1px solid #e8e4db;color:inherit}.post-preview:first-child{border-top:1px solid #e8e4db}.post-preview h2{font-size:1.65rem;margin:12px 0 8px;color:#273437}.post-preview p{margin:0 0 12px}.read-more{font:700 .9rem Arial,sans-serif;color:#13676c}.prose{font-size:1.07rem;line-height:1.85;overflow-wrap:anywhere}.prose img{max-width:100%;height:auto}.prose a{text-decoration:underline}.prose h2{margin-top:1.8em}.source-link{display:block;margin:36px 0;padding:21px 25px;border:1px solid #b7d5d3;background:#f0f8f7;border-radius:12px;font:700 1rem Arial,sans-serif;text-align:center}.source-link:hover{background:#e1f1ef;text-decoration:none}.contact-form{display:grid;gap:17px;max-width:590px;margin-top:25px}.contact-form label{display:grid;gap:8px;font:600 .95rem Arial,sans-serif}.contact-form input,.contact-form textarea{width:100%;padding:13px;border:1px solid #cbd2cf;border-radius:7px;background:white;font:1rem Arial,sans-serif}.contact-form button{background:#145e66;color:white;border:0;border-radius:7px;padding:14px 22px;font:700 1rem Arial,sans-serif;cursor:pointer}.contact-form button:hover{background:#104a50}footer{border-top:1px solid #e8e4db;padding:30px 24px;text-align:center;color:#748084;font: .86rem Arial,sans-serif}
@media(max-width:600px){.masthead img{width:70px;height:70px}.menu{gap:4px 18px;font-size:.82rem}main{padding:32px 19px 70px}}
</style>
</head>
<body><header><div class="masthead"><a href="/" aria-label="The Unlearned Investor home"><img src={logo} alt="The Unlearned Investor logo"/><span class="brand">The Unlearned Investor</span></a></div>
<nav class="menu" aria-label="Main navigation"><a href="/about/">About Me</a><a href="/money-lessons/">Money Lessons</a><a href="/substack-posts/">Substack Posts</a><a href="/podcast/">Podcast</a><a href="/contact/">Contact Me</a></nav></header>
<main><slot/></main><footer>© {new Date().getFullYear()} The Unlearned Investor · Educational content, not financial advice.</footer></body></html>