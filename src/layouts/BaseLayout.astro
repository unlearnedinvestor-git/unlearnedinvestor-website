---
const { title = 'The Unlearned Investor', description = 'Clear thinking for curious investors.', canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={url}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title} | The Unlearned Investor</title><style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1d2936;background:#fcfaf5}*{box-sizing:border-box}body{margin:0}a{color:#126875;text-decoration:none}a:hover{text-decoration:underline}header{border-bottom:1px solid #e8e4d9;background:#fffdf9}.nav{max-width:1120px;margin:auto;padding:19px 24px;display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{font-size:1.2rem;font-weight:850;letter-spacing:-.03em;color:#183b43}.menu{display:flex;gap:22px;flex-wrap:wrap}.menu a{color:#344653;font-weight:600}main{max-width:1040px;margin:0 auto;padding:50px 24px 90px}.eyebrow{font-size:.82rem;text-transform:uppercase;letter-spacing:.18em;color:#3d8a88;font-weight:800}h1{font-size:clamp(2.5rem,6vw,4.6rem);line-height:1.07;letter-spacing:-.055em;margin:16px 0 24px}h2{font-size:1.8rem;letter-spacing:-.035em}p{line-height:1.75;color:#455461}.lead{font-size:1.22rem;max-width:700px}.cta{display:inline-block;border-radius:6px;padding:13px 22px;background:#145e66;color:white;font-weight:700}.cta:hover{color:white;background:#104a50}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin-top:28px}.card{background:white;border:1px solid #ece7dd;border-radius:12px;padding:26px;box-shadow:0 5px 20px #22334408}.card h3{margin:4px 0 10px;font-size:1.3rem}.muted{color:#73808b;font-size:.92rem}.article{max-width:740px;margin:auto}.article h1{font-size:clamp(2.2rem,5vw,3.7rem)}.prose{line-height:1.8;font-size:1.06rem;overflow-wrap:anywhere}.prose img{max-width:100%;height:auto}.prose a{text-decoration:underline}.prose h2{margin-top:2em}footer{border-top:1px solid #e8e4d9;padding:32px 24px;text-align:center;color:#66737a;font-size:.9rem}
</style></head><body><header><nav class="nav"><a class="brand" href="/">THE UNLEARNED INVESTOR</a><div class="menu"><a href="/articles/">Articles</a><a href="/about/">About</a><a href="https://unlearnedinvestor.substack.com/" target="_blank" rel="noopener noreferrer">Newsletter ↗</a></div></nav></header><main><slot /></main><footer>© {new Date().getFullYear()} The Unlearned Investor · Educational content, not financial advice.</footer></body></html>
