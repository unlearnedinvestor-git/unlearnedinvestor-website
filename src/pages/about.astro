---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
const posts=await getCollection('posts');
const about=posts.find(post=>post.data.sourceUrl==='https://unlearnedinvestor.substack.com/p/who-is-the-unlearned-investor');
const rendered=about ? await render(about) : null;
const Content=rendered?.Content;
---
<BaseLayout title="About Me" description="Who is The Unlearned Investor? The story behind the writing and podcast."><article class="article"><div class="eyebrow">About Me</div><h1>Who Is The Unlearned Investor?</h1>{Content ? <div class="prose"><Content /></div> : <p>Read my story on <a href="https://unlearnedinvestor.substack.com/p/who-is-the-unlearned-investor">Substack</a>.</p>}</article></BaseLayout>