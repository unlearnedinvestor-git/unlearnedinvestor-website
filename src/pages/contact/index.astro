---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Me" description="Send a message to The Unlearned Investor."><div class="article"><div class="eyebrow">Get in touch</div><h1>Contact Me</h1><p class="lead">I respond to all mails, just give me sometime to get back</p><form class="contact-form" action="https://formsubmit.co/unlearnedinvestor@gmail.com" method="POST"><input type="hidden" name="_subject" value="New message from The Unlearned Investor website"/><input type="hidden" name="_captcha" value="true"/><input type="hidden" name="_next" value="https://unlearnedinvestor.com/contact/thank-you/"/><label>Your name<input name="name" required maxlength="120" autocomplete="name"/></label><label>Your email<input type="email" name="email" required maxlength="254" autocomplete="email"/></label><label>Your message<textarea name="message" rows="7" required maxlength="10000"></textarea></label><button type="submit">Send message →</button></form></div></BaseLayout>