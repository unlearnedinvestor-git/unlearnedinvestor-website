---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPodcastPost } from '../../utils/podcastPosts.js';
import { hasWrittenArticle } from '../../utils/writtenArticle.js';
const posts=(await getCollection('posts',(post)=>!post.data.draft && Boolean(post.data.sourceUrl) && (!isPodcastPost(post) || hasWrittenArticle(post.body)))).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Substack Posts" description="All The Unlearned Investor Substack articles, latest first."><div class="eyebrow">Writing archive</div><h1>Substack Posts</h1><p class="muted">{posts.length} posts</p><div class="post-list">{posts.map(post=><a class="post-preview" href={'/substack-posts/'+post.slug+'/'}><span class="muted">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</span><h2>{post.data.title}</h2><p>{post.data.description || 'Read the full article.'}</p><span class="read-more">Read article →</span></a>)}</div></BaseLayout>