---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('posts',({data})=>!data.draft && !data.sourceUrl)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Original Articles" description="Original articles published on The Unlearned Investor website."><div class="eyebrow">Website originals</div><h1>Original Articles</h1><div class="post-list">{posts.map(post=><a class="post-preview" href={'/articles/'+post.slug+'/'}><span class="muted">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</span><h2>{post.data.title}</h2><p>{post.data.description || 'Read the full article.'}</p><span class="read-more">Read article →</span></a>)}</div></BaseLayout>