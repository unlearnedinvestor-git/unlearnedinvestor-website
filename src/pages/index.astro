---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postImage } from '../utils/postImages.js';
const posts=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="The Unlearned Investor" description="Unlearn conventional money advice and learn to think like an investor. Explore investing fundamentals, personal finance and independent market analysis.">
<section class="hero"><div class="hero-inner"><h1>THE UNLEARNED<br/>INVESTOR</h1><p>Unlearn what you've been taught about money. Build financial confidence and start thinking like an investor.</p><a class="hero-button" href="/substack-posts/">Explore Articles <span aria-hidden="true">→</span></a></div></section>
<section class="home-posts"><div class="section-heading"><span></span><h2>LATEST POSTS</h2></div><div class="post-list">{posts.map(post=><a class="post-preview" data-post href={(post.data.sourceUrl ? '/substack-posts/' : '/articles/')+post.slug+'/'}><div class="preview-art">{postImage(post) ? <img src={postImage(post)} alt={post.data.title} loading="lazy"/> : <span>THE UNLEARNED<br/>INVESTOR</span>}</div><div class="preview-copy"><div class="eyebrow">{post.data.sourceUrl ? "Substack Posts" : "Money Lessons"}</div><h3>{post.data.title}</h3><p>{post.data.description || 'Read the full article from The Unlearned Investor.'}</p><span class="muted">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</span></div><span class="preview-arrow" aria-hidden="true">›</span></a>)}</div><div id="post-sentinel" aria-hidden="true"></div><p id="post-status" class="muted" aria-live="polite">Scroll for more articles</p></section>
<style>
.hero{min-height:475px;background:#faf8f2;position:relative;display:flex;align-items:center;overflow:hidden}.hero:before{content:'';position:absolute;inset:0 0 0 44%;background:url('/hero.png') right center/auto 115% no-repeat}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#faf8f2 0%,#faf8f2 39%,rgba(250,248,242,.92) 47%,rgba(250,248,242,0) 63%);pointer-events:none}.hero-inner{position:relative;z-index:1}.hero-inner{width:min(1320px,100%);margin:auto;padding:70px 30px}.hero h1{font:800 clamp(3.2rem,6vw,6rem)/.98 Arial,sans-serif;letter-spacing:-.045em;margin:0 0 24px;color:#0d2028}.hero p{font:400 clamp(1.1rem,1.7vw,1.5rem)/1.45 Arial,sans-serif;max-width:620px;color:#193039;margin:0 0 28px}.hero-button{display:inline-flex;gap:25px;align-items:center;padding:17px 25px;background:#064b42;border-radius:5px;color:white;font:700 1rem Arial,sans-serif}.hero-button:hover{background:#07382f;color:white;text-decoration:none}.home-posts{max-width:1100px;margin:auto;padding:42px 25px 85px}.section-heading{display:flex;gap:15px;align-items:center}.section-heading span{width:32px;height:3px;background:#164f51}.section-heading h2{font:800 1.1rem Arial,sans-serif;letter-spacing:.02em}.post-list{gap:14px}.post-preview{display:flex;align-items:center;gap:24px;padding:0;border:1px solid #e7e9e6;border-radius:11px;background:#fff;overflow:hidden;box-shadow:0 3px 14px #122e3009}.post-preview:first-child{border-top:1px solid #e7e9e6}.preview-art{width:28%;min-height:155px;align-self:stretch;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0d4e4b,#9eb6a0);color:#fff;text-align:center;font:800 1.2rem/1.25 Arial,sans-serif;letter-spacing:.04em}.preview-art img{width:100%;height:100%;min-height:155px;object-fit:cover;display:block}.post-preview:nth-child(even) .preview-art{background:linear-gradient(135deg,#aa916a,#344d4b)}.preview-copy{flex:1;padding:19px 0}.preview-copy h3{font:700 1.4rem/1.25 Arial,sans-serif;color:#162b30;margin:8px 0}.preview-copy p{font:1rem/1.55 Arial,sans-serif;color:#596569;margin:0 0 12px}.preview-arrow{font-size:2.2rem;color:#657b7b;padding-right:22px}.all-posts{text-align:center;margin-top:32px;font-weight:700}@media(max-width:700px){.hero{min-height:450px}.hero:before{inset:0 0 0 30%;background-size:auto 100%}.hero:after{background:linear-gradient(90deg,#faf8f2 0%,rgba(250,248,242,.95) 38%,rgba(250,248,242,.35) 100%)}.hero-inner{padding:55px 22px}.preview-art{display:flex;width:34%;min-height:145px}.preview-art img{min-height:145px}.post-preview{padding:0 12px 0 0;gap:12px}.preview-copy{padding:0}.preview-arrow{padding-right:0}.preview-copy h3{font-size:1.15rem}}

#post-sentinel{height:2px}#post-status{text-align:center;margin:22px auto} .post-preview[hidden]{display:none!important}
</style>
<script>
const cards=Array.from(document.querySelectorAll(".post-preview[data-post]"));
let shown=0;const batch=8;const status=document.querySelector("#post-status");
function showMore(){const next=Math.min(cards.length,shown+batch);for(let i=shown;i<next;i++)cards[i].hidden=false;shown=next;if(status)status.textContent=shown<cards.length?"Scroll for more articles":"You have reached the end of the latest posts";}
cards.forEach(card=>card.hidden=true);showMore();
const sentinel=document.querySelector("#post-sentinel");
if(sentinel&&"IntersectionObserver" in window){const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)&&shown<cards.length)showMore();if(shown>=cards.length)observer.disconnect();},{rootMargin:"500px"});observer.observe(sentinel)}else{window.addEventListener("scroll",()=>{if(shown<cards.length&&window.innerHeight+window.scrollY>=document.body.scrollHeight-650)showMore()},{passive:true})}
</script>
</BaseLayout>