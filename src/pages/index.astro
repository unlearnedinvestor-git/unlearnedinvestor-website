---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,6);
---
<BaseLayout title="Think independently. Invest thoughtfully." description="Learn investing fundamentals, company analysis, valuation and how to separate signal from noise."><section><div class="eyebrow">Independent thinking starts here</div><h1>Better investing begins with <em>unlearning.</em></h1><p class="lead">A straightforward place to question the noise, understand businesses, and build your own investment judgment — one idea at a time.</p><a class="cta" href="https://unlearnedinvestor.substack.com/" target="_blank" rel="noopener noreferrer">Subscribe to the newsletter ↗</a></section><section style="margin-top:70px"><div class="eyebrow">What we explore</div><div class="cards"><div class="card"><h3>Investing foundations</h3><p>Understand the concepts behind long-term investing without the jargon.</p></div><div class="card"><h3>Businesses & valuation</h3><p>Read financial statements and examine what a company is actually worth.</p></div><div class="card"><h3>Signal versus noise</h3><p>Think clearly about market narratives, incentives, and investor psychology.</p></div></div></section><section style="margin-top:70px"><h2>Latest articles</h2>{posts.length ? <div class="cards">{posts.map(post=><a class="card" href={'/articles/'+post.slug+'/'}><div class="muted">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>)}</div> : <p>The first articles are on their way. In the meantime, <a href="https://unlearnedinvestor.substack.com/">read us on Substack</a>.</p>}<p><a href="/articles/">Browse all articles →</a></p></section></BaseLayout>
