---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('posts',({data})=>!data.draft && Boolean(data.sourceUrl))).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,8);
---
<BaseLayout title="The Unlearned Investor"><section><div class="eyebrow">Recent writing</div><h1>Latest from The Unlearned Investor</h1><div class="post-list">{posts.map(post=><a class="post-preview" href={'/substack-posts/'+post.slug+'/'}><span class="muted">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</span><h2>{post.data.title}</h2><p>{post.data.description || 'Read the full article.'}</p><span class="read-more">Read article →</span></a>)}</div><p><a href="/substack-posts/">Explore all Substack posts →</a></p></section></BaseLayout>